# RepoGuard runtime settings
REPO_URL=https://github.com/example/project
REPORT_DIR=/app/reports

# Optional Gemini report enrichment. Without this key RepoGuard still runs all scanners
# and produces a heuristic local agent report.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_ENABLED=true

# Budget controls
MAX_CONTEXT_TOKENS=120000
WARN_TOKEN_RATIO=0.8
HARD_TOKEN_CAP=150000
BUDGET_USD=1.50
# Gemini free-tier default. Override these if you switch to paid-tier pricing.
INPUT_COST_PER_1K=0
OUTPUT_COST_PER_1K=0

# Scanner controls
SCANNER_TIMEOUT_SECONDS=300
MAX_OUTPUT_BYTES=1048576
MAX_CONCURRENCY=5
FAIL_ON_SEVERITY=high
